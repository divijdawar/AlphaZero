# Virtual environments (uv / venv)
.venv/
venv/
.python-version

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / lint caches (also self-ignored after first run, listed here so clean checkouts ignore them)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json

# Coverage
.coverage
coverage.xml
htmlcov/
*.cover

# Build / packaging (hatchling)
build/
dist/
*.egg-info/
*.whl

# Training artefacts (run_pipeline default checkpoint_dir='checkpoints')
checkpoints/
*.pt
*.pth
*.safetensors
*.npz

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local BAI experiment
/bai/
